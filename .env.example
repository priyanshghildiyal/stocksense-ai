# Database
DATABASE_URL=postgresql://stocksense:stocksense@localhost:5432/stocksense?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Optional Redis (leave empty for in-memory cache)
REDIS_URL=

# Optional OpenAI (research features stay unavailable without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Market data
MARKET_UNIVERSE=US_IN
QUOTE_REFRESH_CRON=*/5 * * * *
ALERT_EVAL_CRON=*/2 * * * *

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Frontend (Frontend/.env)
# VITE_API_BASE_URL=
# VITE_MARKET_API_URL=/api/market/securities
# VITE_MARKET_POLL_MS=30000
